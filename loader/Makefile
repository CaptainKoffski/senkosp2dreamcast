# Requires: source tools/kos/environ.sh from the repo root (gitignored KOS
# checkout -- setup in docs/kb/tooling.md).
KIT ?= $(abspath ../kit)
DAT ?= senkosp.dat
OBJS = main.o handoff.o gd.o gd_sys.o shim_blob.o bios_data.o splash_blob.o naomi_crc.o \
       menu.o ctl_lib.o menu_sheet_blob.o ctl_pad_blob.o ctl_stick_blob.o logo_blob.o
CFLAGS += -I. -I../shims/include -I../build -I$(KIT)/loader
CFLAGS += $(DEFS)   # debug toggles from the top Makefile (e.g. SERIAL=1)
# LZ4=1: the kit's gd.c includes the port's src/gd_lz4.inc.c (T10b).
ifneq (,$(findstring SHIM_LZ4,$(DEFS)))
CFLAGS += -I../shims/src
endif
# T10b spike (THROWAWAY, branch t10b-spike): LZ4BENCH=1 adds the SH4
# decompress benchmark + its embedded sample. Vendored lz4 v1.10.0
# (tools/t10b/lz4, BSD) compiles under kos-cc unchanged.
ifneq (,$(findstring LOADER_LZ4BENCH,$(DEFS)))
OBJS += lz4bench.o lz4_sh4.o t10b_sample_blob.o
endif
BIOS = ../bios/naomi/epr-21576h.ic27   # Naomi Japan bios0 (gitignored ROM)
include $(KIT)/loader/rules.mk
# KERNEL-SLICE pin (docs/kb/phase4-conversion.md §"Low-RAM placements — spec
# pin P6 (KERNEL-SLICE), BLOB-CHECK", Task 5): the plan's single-dd recipe
# does not work (a ROM offset for RAM 0x600 would be negative) -- the window
# [0x600,0x3800) is three pieces, byte-compare verified against
# tools/ram-snapshot.bin. Literal numbers mirror
# ../shims/include/shim_iface.h's KERNEL_A/B/C_LEN + BIOS60000_LEN (the C
# header is the single source of truth for the shim/loader; this Makefile
# needs the same numbers to build bios_data.bin, and
# shims/test/test_game_values.c asserts the header's own arithmetic).
BIOS60000_OFF     = 393216   # 0x60000
BIOS60000_LEN     = 28672    # 0x7000
KERNEL_A_SNAP_OFF = 1536     # 0x600 in tools/ram-snapshot.bin
KERNEL_A_LEN      = 512      # 0x200: snapshot-only (no ROM source)
KERNEL_B_LEN      = 2048     # 0x800: zero-fill (snapshot reads all-zero here)
KERNEL_ROM_OFF    = 2048     # 0x800: piece C ROM skip
KERNEL_C_LEN      = 10240    # 0x2800: ROM-identical to RAM 0x1000-0x3800
BIOS_DATA_TOTAL   = 41472    # 0xa200 = BIOS60000_LEN + KERNEL_A_LEN + KERNEL_B_LEN + KERNEL_C_LEN
# bios_data.bin layout: [BIOS60000_LEN blob][KERNEL_A_LEN][KERNEL_B_LEN][KERNEL_C_LEN]
# concatenated -- matches shim_iface.h's BIOS_DATA_*_OFF constants, so the
# loader indexes by name, not by re-deriving offsets.
# .DELETE_ON_ERROR + size check (final review, Cleopatra): dd exits 0 on
# short/past-EOF reads, so a wrong/truncated BIOS or missing snapshot would
# silently embed a short blob and the loader memcpys fixed lengths past its
# end. Explicit existence check on the snapshot (gitignored, regenerable)
# because it is NOT a normal timestamp-tracked prerequisite here (34 MB,
# effectively static -- tracking its mtime would force a rebuild on every
# `git checkout`); the check still fails the build with a clear message
# rather than a short silent blob.
../build/bios_data.bin: $(BIOS)
	mkdir -p ../build
	@test -f ../tools/ram-snapshot.bin || { echo "bios_data.bin: ../tools/ram-snapshot.bin missing (gitignored, regenerable -- docs/kb/tooling.md Phase 3: RAM snapshot)"; exit 1; }
	dd if=$(BIOS) bs=1 skip=$(BIOS60000_OFF) count=$(BIOS60000_LEN) 2>/dev/null > $@
	dd if=../tools/ram-snapshot.bin bs=1 skip=$(KERNEL_A_SNAP_OFF) count=$(KERNEL_A_LEN) 2>/dev/null >> $@
	dd if=/dev/zero bs=1 count=$(KERNEL_B_LEN) 2>/dev/null >> $@
	dd if=$(BIOS) bs=1 skip=$(KERNEL_ROM_OFF) count=$(KERNEL_C_LEN) 2>/dev/null >> $@
	@test $$(stat -f%z $@) -eq $(BIOS_DATA_TOTAL) || { echo "bios_data.bin wrong size (bad BIOS/snapshot?)"; rm -f $@; exit 1; }
# main.c #includes ../build/patch_table.h (Task 9: generated by
# scripts/build_patch_table.py) and shim_iface.h. KOS Makefile.rules has no
# header-dependency tracking, so declare both explicitly: without this a
# header change (new patch addresses, new CART_FAD) would NOT rebuild main.o
# and the loader would silently keep the stale values (bit Cleopatra in B5:
# CART_FAD change didn't take until an unrelated main.c edit).
main.o: $(KIT)/loader/menu.h $(KIT)/loader/ctl_lib.h menu_layout.h ../build/patch_table.h ../shims/include/shim_iface.h
# Port-specific inputs of scripts/build_patch_table.py (rule in rules.mk).
../build/patch_table.h: ../scripts/reloc_patchset.json
../build/patch_table.h: ../scripts/port_def.py
# T10b spike rules (THROWAWAY). Sample blob: host tool carves + LZ4-HC-9
# compresses 8 x 128 KB stripes of the T10 stage pak from ../senkosp.dat
# (gitignored ROM -- the blob is derived game bytes, ../build only, never
# committed). Host cc, not kos-cc.
lz4_sh4.o: ../tools/t10b/lz4/lz4.c
	kos-cc $(CFLAGS) $(CPPFLAGS) -c $< -o $@
lz4bench.o: lz4bench.c ../tools/t10b/lz4/lz4.h $(KIT)/loader/naomi_crc.h
../build/pack_sample: ../tools/t10b/pack_sample.c ../tools/t10b/lz4/lz4.c \
                      ../tools/t10b/lz4/lz4hc.c $(KIT)/loader/naomi_crc.c
	cc -O2 -I$(KIT)/loader -o $@ ../tools/t10b/pack_sample.c ../tools/t10b/lz4/lz4.c \
	  ../tools/t10b/lz4/lz4hc.c $(KIT)/loader/naomi_crc.c
../build/t10b_sample.bin: ../build/pack_sample ../senkosp.dat
	../build/pack_sample ../senkosp.dat $@
t10b_sample_blob.o: ../build/t10b_sample.bin
	sh-elf-objcopy -I binary -O elf32-shl -B sh4 \
	  --redefine-sym _binary____build_t10b_sample_bin_start=_t10b_sample \
	  --redefine-sym _binary____build_t10b_sample_bin_end=_t10b_sample_end \
	  $< $@
